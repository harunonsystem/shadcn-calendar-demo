{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>harunonsystem/.github:renovate-config.jsonc",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "groupName": "React",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "Storybook",
      "matchPackagePatterns": [
        "^@storybook/",
        "^storybook"
      ]
    },
    {
      "groupName": "Radix UI",
      "matchPackagePatterns": [
        "^@radix-ui/"
      ]
    },
    {
      "groupName": "Testing",
      "matchPackagePatterns": [
        "^@testing-library/",
        "^vitest"
      ]
    },
    {
      "matchPackagePatterns": [
        "^@vitest/",
        "^vitest$"
      ],
      "allowedVersions": "<5"
    },
    {
      "groupName": "Linting & Formatting",
      "matchPackageNames": [
        "oxlint",
        "oxfmt",
        "eslint",
        "prettier"
      ]
    }
  ],
  "schedule": [
    "on saturday"
  ],
  "automerge": true,
  "automergeType": "pr"
}
